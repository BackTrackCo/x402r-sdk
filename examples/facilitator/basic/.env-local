# x402r Facilitator — Environment Variables
#
# 1. Deploy an operator:  PRIVATE_KEY=0x... pnpm example:deploy-operator
# 2. Copy OPERATOR_ADDRESS here
# 3. Rename this file to .env
# 4. Run:  pnpm example:facilitator

PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE
OPERATOR_ADDRESS=0x_YOUR_OPERATOR_ADDRESS_HERE
NETWORK=eip155:84532
PORT=4022
