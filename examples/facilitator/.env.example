# Facilitator service configuration
# Copy this file to .env and fill in the values

# Private key for the facilitator wallet (used to call authorize() on-chain)
# Must have Base Sepolia ETH for gas
# Get testnet ETH: https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
PRIVATE_KEY=0x...

# PaymentOperator address - deployed via deploy-operator example
# Run: PRIVATE_KEY=0x... pnpm example:deploy-operator
OPERATOR_ADDRESS=0x...

# Network (CAIP-2 format, default: eip155:84532 for Base Sepolia)
NETWORK=eip155:84532

# Optional: Port to run the facilitator on (default: 4022)
PORT=4022
