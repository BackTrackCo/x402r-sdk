# Arbiter CLI configuration
# Copy this file to .env and fill in the values

# Private key for the arbiter wallet
# Must have Base Sepolia ETH for gas
# Get testnet ETH: https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
PRIVATE_KEY=0x...your_arbiter_private_key...

# PaymentOperator address - the operator this arbiter serves
# Run: PRIVATE_KEY=0x... pnpm tsx examples/deploy-operator/index.ts
OPERATOR_ADDRESS=0xbb4f390b80E4F4895B96B95AE382B65fDC45974B

# Freeze contract address (from deploy-operator output, optional)
FREEZE_ADDRESS=0xD0f99B7667076f151FD8240b277f1765d147e48C

# Receiver address to query refund requests for
# If not set, defaults to the arbiter wallet address
# RECEIVER_ADDRESS=0x...
