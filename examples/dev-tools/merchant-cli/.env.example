# Merchant CLI configuration
# Copy this file to .env and fill in the values

# Private key for the merchant wallet
# Must have Base Sepolia ETH for gas
# Get testnet ETH: https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
PRIVATE_KEY=0x...your_merchant_private_key...

# PaymentOperator address - deployed via deploy-operator example
# Run: PRIVATE_KEY=0x... pnpm tsx examples/deploy-operator/index.ts
OPERATOR_ADDRESS=0x8140b98ec518843EA1Dd40C42617ACBa71752C33

# Freeze contract address (from deploy-operator output)
FREEZE_ADDRESS=0x6d64A0B25A1494f347941614fc8799B486a603A6
