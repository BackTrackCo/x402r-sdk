# Client CLI configuration
# Copy this file to .env and fill in the values

# Private key for the payer wallet
# Must have:
# - Base Sepolia ETH for gas (freeze/refund operations)
# - Base Sepolia USDC for payments
# Get testnet tokens from:
# - ETH: https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
# - USDC: https://faucet.circle.com/ (select Base Sepolia)
PRIVATE_KEY=0x...

# ============ Reference Addresses (Base Sepolia) ============
# These are pre-deployed example operator addresses you can use for testing.
# You can also deploy your own via: PRIVATE_KEY=0x... pnpm example:deploy-operator

# Short-escrow operator (5min escrow, 3min freeze, 1% fee) for E2E testing
# OPERATOR_ADDRESS=0x8140b98ec518843EA1Dd40C42617ACBa71752C33
# FREEZE_ADDRESS=0x6d64A0B25A1494f347941614fc8799B486a603A6
# ESCROW_PERIOD_ADDRESS=0x0402f5b49126786c01c3e0885767bB11C0199372

# Protocol contracts (same for all operators on Base Sepolia)
# USDC: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# RefundRequest: 0x1C2Ab244aC8bDdDB74d43389FF34B118aF2E90F4
# AuthCaptureEscrow: 0x29025c0E9D4239d438e169570818dB9FE0A80873
