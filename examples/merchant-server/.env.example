# Merchant server configuration
# Copy this file to .env and fill in the values

# Private key for the merchant wallet (used to pay gas for authorize())
# Must have Base Sepolia ETH for gas
# Get testnet ETH: https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
PRIVATE_KEY=0x...

# PaymentOperator address - deployed via deploy-operator example
# Run: PRIVATE_KEY=0x... pnpm example:deploy-operator
# Example (Base Sepolia): 0xbb4f390b80E4F4895B96B95AE382B65fDC45974B
OPERATOR_ADDRESS=0xbb4f390b80E4F4895B96B95AE382B65fDC45974B

# Freeze contract address (from deploy-operator output)
# Example (Base Sepolia): 0xD0f99B7667076f151FD8240b277f1765d147e48C
FREEZE_ADDRESS=0xD0f99B7667076f151FD8240b277f1765d147e48C

# EscrowPeriod contract address (from deploy-operator output)
# Example (Base Sepolia): 0xFcFb7e197823D304D53F47BE1E9761e9D102589b
ESCROW_PERIOD_ADDRESS=0xFcFb7e197823D304D53F47BE1E9761e9D102589b

# Optional: Port to run the server on (default: 3000)
PORT=3000
