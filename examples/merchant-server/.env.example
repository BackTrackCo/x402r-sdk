# Merchant server configuration
# Copy this file to .env and fill in the values

# Private key for the merchant wallet (used for release operations)
# Must have Base Sepolia ETH for gas
# Get testnet ETH: https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
PRIVATE_KEY=0x...

# PaymentOperator address - deployed via deploy-operator example
# Run: PRIVATE_KEY=0x... pnpm example:deploy-operator
OPERATOR_ADDRESS=0x...

# URL of the x402r facilitator service (default: http://localhost:4022)
# Start facilitator first: cd examples/facilitator && pnpm dev
FACILITATOR_URL=http://localhost:4022

# Optional: Port to run the server on (default: 3000)
PORT=3000
