{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "packages/core/src/index.ts",
    "packages/client/src/index.ts",
    "packages/merchant/src/index.ts",
    "packages/arbiter/src/index.ts",
    "packages/helpers/src/index.ts"
  ],
  "entryPointStrategy": "expand",
  "out": "docs-generated",
  "exclude": ["**/tests/**", "**/node_modules/**", "**/*.test.ts"],
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "skipErrorChecking": true,
  "sort": ["alphabetical"],
  "readme": "README.md",
  "githubPages": true,
  "name": "X402r SDK API Reference",
  "highlightLanguages": ["typescript", "javascript", "json", "bash", "solidity"]
}
