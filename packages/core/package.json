{
  "name": "@x402r/core",
  "version": "0.3.0",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./payment": {
      "types": "./dist/payment.d.ts",
      "default": "./dist/payment.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "default": "./dist/actions.js"
    },
    "./deploy": {
      "types": "./dist/deploy.d.ts",
      "default": "./dist/deploy.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest run --project core",
    "test:fork": "vitest run --project core:fork",
    "test:cov": "vitest run --coverage --project core",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "publint --strict && attw --pack --ignore-rules no-resolution cjs-resolves-to-esm"
  },
  "dependencies": {
    "viem": "^2.46.3"
  },
  "peerDependencies": {
    "@x402r/evm": ">=0.0.3"
  },
  "peerDependenciesMeta": {
    "@x402r/evm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@x402r/evm": "0.0.3",
    "prool": "^0.2.3"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 kB"
    },
    {
      "path": "dist/config.js",
      "limit": "2 kB"
    },
    {
      "path": "dist/deploy.js",
      "limit": "3 kB"
    }
  ]
}
