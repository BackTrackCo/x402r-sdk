{
  "name": "@x402r/core",
  "version": "0.3.0-alpha.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BackTrackCo/x402r-sdk.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./payment": {
      "types": "./dist/payment.d.ts",
      "default": "./dist/payment.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "default": "./dist/actions.js"
    },
    "./deploy": {
      "types": "./dist/deploy.d.ts",
      "default": "./dist/deploy.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:unit": "vitest run --project core",
    "test:fork": "vitest run --project core:fork",
    "test:cov": "vitest run --coverage --project core",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "^2.52.2"
  },
  "devDependencies": {
    "@x402/evm": "^2.15.0",
    "@x402r/test-fixtures": "workspace:*"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 kB"
    },
    {
      "path": "dist/config.js",
      "limit": "3 kB"
    },
    {
      "path": "dist/deploy.js",
      "limit": "3 kB"
    }
  ]
}
