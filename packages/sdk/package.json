{
  "name": "@x402r/sdk",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "default": "./dist/actions.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:typecheck": "vitest --typecheck --run"
  },
  "dependencies": {
    "@x402r/core": "workspace:*",
    "viem": "^2.46.3"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "6 kB"
    },
    {
      "path": "dist/actions.js",
      "limit": "2 kB"
    },
    {
      "path": "dist/plugins.js",
      "limit": "2 kB"
    }
  ]
}
