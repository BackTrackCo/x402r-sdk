{
  "name": "@x402r/sdk",
  "version": "0.3.0-alpha.0",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BackTrackCo/x402r-sdk.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "default": "./dist/actions.js"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "default": "./dist/plugins.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:typecheck": "vitest --typecheck --run",
    "prepublishOnly": "publint --strict && attw --pack --ignore-rules no-resolution cjs-resolves-to-esm"
  },
  "dependencies": {
    "@x402r/core": "workspace:^",
    "@x402r/erc8004": "^0.1.0-alpha.2",
    "viem": "^2.46.3"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "6 kB"
    },
    {
      "path": "dist/actions.js",
      "limit": "2 kB"
    },
    {
      "path": "dist/plugins.js",
      "limit": "2 kB"
    }
  ]
}
