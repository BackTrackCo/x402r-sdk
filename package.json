{
  "name": "x402r-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:fork": "turbo run test:fork",
    "typecheck": "turbo run typecheck",
    "check": "biome check .",
    "format": "biome check --write .",
    "test:cov": "turbo run test:cov",
    "clean": "turbo run clean",
    "generate:abis": "wagmi generate",
    "changeset": "changeset",
    "version": "changeset version",
    "publint": "pnpm --filter=@x402r/core exec publint --strict && pnpm --filter=@x402r/helpers exec publint --strict && pnpm --filter=@x402r/sdk exec publint --strict",
    "attw": "pnpm --filter=@x402r/core exec attw --pack --ignore-rules no-resolution cjs-resolves-to-esm && pnpm --filter=@x402r/helpers exec attw --pack --ignore-rules no-resolution cjs-resolves-to-esm && pnpm --filter=@x402r/sdk exec attw --pack --ignore-rules no-resolution cjs-resolves-to-esm",
    "knip": "knip",
    "size-limit": "pnpm --filter=@x402r/core exec size-limit && pnpm --filter=@x402r/helpers exec size-limit && pnpm --filter=@x402r/sdk exec size-limit",
    "test:pkg": "pnpm publint && pnpm attw",
    "example:payer:request-refund": "pnpm --filter examples run payer:request-refund",
    "example:payer:submit-evidence": "pnpm --filter examples run payer:submit-evidence",
    "example:merchant:charge": "pnpm --filter examples run merchant:charge",
    "example:merchant:release": "pnpm --filter examples run merchant:release",
    "example:arbiter:distribute-fees": "pnpm --filter examples run arbiter:distribute-fees",
    "example:arbiter:approve-refund": "pnpm --filter examples run arbiter:approve-refund",
    "example:payer:freeze": "pnpm --filter examples run payer:freeze",
    "example:arbiter:review-evidence": "pnpm --filter examples run arbiter:review-evidence",
    "scenario:release": "pnpm --filter examples run scenario:release",
    "scenario:dispute": "pnpm --filter examples run scenario:dispute",
    "scenarios:ci": "pnpm --filter examples run scenarios:ci"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.11",
      "picomatch": ">=4.0.4",
      "vite": ">=7.3.2",
      "fast-uri": ">=3.1.2"
    },
    "patchedDependencies": {
      "http-proxy@1.18.1": "patches/http-proxy@1.18.1.patch"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.15",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@size-limit/file": "^12.1.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@wagmi/cli": "^2.10.0",
    "knip": "^5.85.0",
    "publint": "^0.3.21",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "turbo": "^2.9.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
