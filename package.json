{
  "name": "x402r-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:fork": "turbo run test:fork",
    "typecheck": "turbo run typecheck",
    "check": "biome check .",
    "format": "biome check --write .",
    "test:cov": "turbo run test:cov",
    "clean": "turbo run clean",
    "generate:abis": "wagmi generate",
    "changeset": "changeset",
    "version": "changeset version",
    "knip": "knip",
    "size-limit": "pnpm --filter=@x402r/core exec size-limit && pnpm --filter=@x402r/helpers exec size-limit && pnpm --filter=@x402r/sdk exec size-limit",
    "test:pkg": "turbo run build --force",
    "scenario:http-wire-capture": "pnpm --filter examples run scenario:http-wire-capture",
    "snippets:check": "pnpm --filter @x402r/example-snippets run typecheck"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.11",
      "picomatch": ">=4.0.4",
      "vite": ">=7.3.2",
      "fast-uri": ">=3.1.2",
      "esbuild": ">=0.28.1"
    },
    "patchedDependencies": {
      "http-proxy@1.18.1": "patches/http-proxy@1.18.1.patch"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.3",
    "@biomejs/biome": "^2.4.16",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@size-limit/file": "^12.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@wagmi/cli": "^2.10.0",
    "knip": "^6.16.1",
    "publint": "^0.3.21",
    "size-limit": "^12.1.0",
    "tsdown": "0.22.2",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
