{
  "rules": {
    "duplicates": "off"
  },
  "workspaces": {
    ".": {
      "vitest": false,
      "entry": ["wagmi.config.ts", "vitest.workspace.ts"],
      "ignoreDependencies": ["@vitest/coverage-v8"]
    },
    "packages/core": {
      "entry": ["tests/**/*.test.ts", "tests/**/*.ts", "vitest.config.ts"],
      "ignore": ["src/abis/generated.ts"]
    },
    "packages/helpers": {
      "entry": ["tests/**/*.test.ts", "tests/**/*.ts", "vitest.config.ts"]
    },
    "packages/sdk": {
      "entry": ["tests/**/*.test.ts", "tests/**/*.ts", "vitest.config.ts"]
    },
    "packages/cli": {
      "entry": ["tests/**/*.test.ts", "tests/**/*.ts", "vitest.config.ts"]
    },
    "examples/snippets": {
      "entry": ["**/*.ts"]
    }
  }
}
