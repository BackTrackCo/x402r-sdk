# Supply-chain hardening: explicitly disable npm-style pre/post script
# hooks (e.g. `prebuild`, `postbuild`). This is the pnpm v10 default;
# declared here so the security stance is visible in the repo and not
# accidentally overridden by a future config change.
enable-pre-post-scripts=false

# Fail `pnpm install` fast when Node is below the `engines.node` floor
# (>=22.18.0, required by the tsdown build toolchain). Without this, an
# unsupported Node only surfaces later as a cryptic mid-build error.
engine-strict=true
